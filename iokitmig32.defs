/*
 * Requests of 32-bit (i386) clients whose layout differs from the one the
 * 64-bit server (iokitmig.defs) decodes. A 32-bit client calls the routines
 * without the _64 suffix, whose asynchronous reference is an array of 32-bit
 * words; the 64-bit decoding of the same message ids expects 64-bit words and
 * rejects the request with MIG_BAD_ARGUMENTS. The routines below declare the
 * 32-bit shape under the same message ids, and every other id is skipped so
 * that the 64-bit server handles it. iokit32_dispatch() tries this subsystem
 * first. Routine numbering follows the numbering of the 64-bit subsystem.
 */
subsystem iokit32 2800;

#include <mach/std_types.defs>
#include <mach/mach_types.defs>

import <device/device_types.h>;
import "iokit32_types.h";

serverprefix is32_;

type io_name_t            = c_string[*:128];
type io_struct_inband_t   = array[*:4096] of char;
type io_async_ref32_t     = array[*:8] of natural_t;
type io_object_t          = mach_port_t
		ctype: mach_port_t;

